{
  "name": "dusk-dawn",
  "version": "2.2.0",
  "description": "Editorial Dusk & Dawn: the shared design package for Waymark, BookShelf, Ledger, Colophon, Rosetta, Mise and Nookling. Tokens, Fraunces, shared components, the colour checks and the world places gazetteer.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/not-mehul/dusk-dawn.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "dusk-dawn": "bin/dusk-dawn.mjs"
  },
  "files": [
    "bin",
    "css",
    "fonts",
    "svelte",
    "places/index.js",
    "places/index.d.ts",
    "places/vite.js",
    "places/vite.d.ts",
    "places/world.txt",
    "places/LICENSE.md",
    "tokens.json",
    "style.md"
  ],
  "exports": {
    ".": {
      "types": "./svelte/index.d.ts",
      "svelte": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./expressive": {
      "types": "./svelte/expressive.d.ts",
      "default": "./svelte/expressive.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./components.css": "./css/components.css",
    "./tokens.json": "./tokens.json",
    "./fonts/*": "./fonts/*",
    "./places": {
      "types": "./places/index.d.ts",
      "default": "./places/index.js"
    },
    "./places/vite": {
      "types": "./places/vite.d.ts",
      "default": "./places/vite.js"
    },
    "./places/world.txt": "./places/world.txt",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./svelte/index.js",
  "types": "./svelte/index.d.ts",
  "scripts": {
    "build": "node bin/dusk-dawn.mjs build",
    "check": "node bin/dusk-dawn.mjs verify && node --test places/places.test.mjs && node bin/dusk-dawn.mjs colours css svelte && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "places": "node --max-old-space-size=6144 scripts/build-places.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3"
  },
  "author": "Mehul Sen"
}
